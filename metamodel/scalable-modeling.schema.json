{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:scalable-modeling:schema:v0.1",
  "title": "Scalable Modeling Metamodel v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "elements",
    "relationships",
    "views"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "human",
            "ai",
            "import",
            "system"
          ]
        },
        "id": {
          "type": "string"
        },
        "displayName": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "manual",
            "transcript",
            "document",
            "import",
            "ai"
          ]
        },
        "sourceId": {
          "type": "string"
        },
        "uri": {
          "type": "string"
        },
        "speaker": {
          "type": "string"
        },
        "startMs": {
          "type": "integer",
          "minimum": 0
        },
        "endMs": {
          "type": "integer",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "createdBy": {
          "$ref": "#/$defs/actor"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "$ref": "#/$defs/source"
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "namedElement": {
      "type": "object",
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "type": "string"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "command": {
      "allOf": [
        {
          "$ref": "#/$defs/namedElement"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "type",
            "name"
          ],
          "properties": {
            "id": {
              "$ref": "#/$defs/id"
            },
            "type": {
              "const": "command"
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string"
            },
            "provenance": {
              "$ref": "#/$defs/provenance"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "visibility"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "event"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "visibility": {
          "enum": [
            "unspecified",
            "private",
            "public"
          ]
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "query"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name",
        "roles",
        "authority",
        "stateSource"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "model"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "command",
              "query",
              "derived"
            ]
          },
          "uniqueItems": true
        },
        "authority": {
          "enum": [
            "unspecified",
            "authoritative",
            "non_authoritative"
          ]
        },
        "stateSource": {
          "enum": [
            "unspecified",
            "stored",
            "event_projection",
            "aggregation"
          ]
        },
        "partitionKeys": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "gatekeeper",
            "command_handler",
            "event_handler",
            "query_handler",
            "data_aggregator"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "boundedContext": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "bounded_context"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "consistencyBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "consistency_boundary"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "hotspotTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "element",
            "relationship",
            "view",
            "model"
          ]
        },
        "id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "hotspot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "hotspot"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "open",
            "resolved"
          ]
        },
        "resolution": {
          "type": "string"
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hotspotTarget"
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "descriptionElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "description"
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hotspotTarget"
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "glossaryTerm": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "term",
        "definition"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "const": "glossary_term"
        },
        "term": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "synonyms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "element": {
      "oneOf": [
        {
          "$ref": "#/$defs/command"
        },
        {
          "$ref": "#/$defs/event"
        },
        {
          "$ref": "#/$defs/query"
        },
        {
          "$ref": "#/$defs/model"
        },
        {
          "$ref": "#/$defs/policy"
        },
        {
          "$ref": "#/$defs/boundedContext"
        },
        {
          "$ref": "#/$defs/consistencyBoundary"
        },
        {
          "$ref": "#/$defs/hotspot"
        },
        {
          "$ref": "#/$defs/descriptionElement"
        },
        {
          "$ref": "#/$defs/glossaryTerm"
        }
      ]
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "sourceId",
        "targetId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "precedes",
            "causes",
            "handles",
            "dispatches",
            "emits",
            "invokes",
            "reads",
            "updates",
            "projects_into",
            "belongs_to",
            "within_boundary",
            "defines"
          ]
        },
        "sourceId": {
          "$ref": "#/$defs/id"
        },
        "targetId": {
          "$ref": "#/$defs/id"
        },
        "description": {
          "type": "string"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "width": {
          "type": "number",
          "minimum": 0
        },
        "height": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "viewElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "elementId",
        "bounds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "elementId": {
          "$ref": "#/$defs/id"
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "hidden": {
          "type": "boolean"
        },
        "collapsed": {
          "type": "boolean"
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "viewRelationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "relationshipId"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "relationshipId": {
          "$ref": "#/$defs/id"
        },
        "waypoints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "hidden": {
          "type": "boolean"
        },
        "style": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "freeformElement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "bounds"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "text",
            "rectangle",
            "ellipse",
            "arrow",
            "line",
            "drawing",
            "image"
          ]
        },
        "bounds": {
          "$ref": "#/$defs/bounds"
        },
        "text": {
          "type": "string"
        },
        "data": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "elements",
        "relationships",
        "freeform"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "temporal",
            "context",
            "ceqs",
            "consistency",
            "freeform"
          ]
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewElement"
          }
        },
        "relationships": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/viewRelationship"
          }
        },
        "freeform": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/freeformElement"
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
